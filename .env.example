# No OPENAI_API_KEY is required. This project uses Codex/ChatGPT MCP access,
# not direct OpenAI Platform API calls. The token below is local to Blender.
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_PATH=/mcp
BLENDER_BRIDGE_URL=http://127.0.0.1:8765
BLENDER_BRIDGE_TOKEN=replace-with-token-generated-in-blender
BLENDER_COMMAND_TIMEOUT_MS=30000
BLENDER_RENDER_TIMEOUT_MS=120000
LOG_LEVEL=info
